{
  parserClass="com.example.cobolstaticanalysisplugin.parser.SimpleParser"

  extends="com.intellij.extapi.psi.ASTWrapperPsiElement"

  psiClassPrefix="Simple"
  psiImplClassSuffix="Impl"
  psiPackage="com.example.cobolstaticanalysisplugin.psi"
  psiImplPackage="com.example.cobolstaticanalysisplugin.psi.impl"

  elementTypeHolderClass="com.example.cobolstaticanalysisplugin.SimpleTypes"
  elementTypeClass="com.example.cobolstaticanalysisplugin.SimpleElementType"
  tokenTypeClass="com.example.cobolstaticanalysisplugin.SimpleTokenType"
}

simpleFile ::= item_*

private item_ ::= (property|COMMENT|CRLF)

property ::= (KEY? SEPARATOR VALUE?) | KEY